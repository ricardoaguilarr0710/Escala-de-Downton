<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Escala Downton</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <main class="container">
    <h1>Escala Downton</h1>

    <form id="downton-form">
      <div class="campo">
        <label for="respuestaVerbal">Respuesta verbal (0-2):</label>
        <select id="respuestaVerbal">
          <option value="0">0</option>
          <option value="1">1</option>
          <option value="2">2</option>
        </select>
      </div>

      <div class="campo">
        <label for="respuestaMotora">Respuesta motora (0-2):</label>
        <select id="respuestaMotora">
          <option value="0">0</option>
          <option value="1">1</option>
          <option value="2">2</option>
        </select>
      </div>

      <div class="campo">
        <label for="respiracion">Respiración (0-2):</label>
        <select id="respiracion">
          <option value="0">0</option>
          <option value="1">1</option>
          <option value="2">2</option>
        </select>
      </div>

      <div class="campo">
        <label for="tonoMuscular">Tono muscular (0-2):</label>
        <select id="tonoMuscular">
          <option value="0">0</option>
          <option value="1">1</option>
          <option value="2">2</option>
        </select>
      </div>

      <div class="campo">
        <label for="conciencia">Conciencia (0-2):</label>
        <select id="conciencia">
          <option value="0">0</option>
          <option value="1">1</option>
          <option value="2">2</option>
        </select>
      </div>

      <button type="submit">Calcular</button>
    </form>

    <section id="resultado" class="resultado">
      <h2>Resultado</h2>
      <p id="puntaje">Puntuación total: 0</p>
      <p id="clasificacion">Clasificación: --</p>
    </section>
  </main>

  <script src="script.js"></script>
</body>
</html>
